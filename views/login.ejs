<%- include('partials/head') %>
<body class="flex flex-col min-h-screen">
    <%- include('partials/navbar') %>

    <div class="bg-bat-blue flex-1 flex flex-col justify-center items-center px-4 py-8">
        <div class="bg-bat-blue-dark border-2 border-bat-yellow-light min-h-50 py-6 w-full max-w-70 flex flex-col justify-center items-center">
            <h1 class="mb-4 text-xl text-bat-yellow">Log-In Form</h1>
            <form class="w-full px-6 gap-y-2 flex flex-col items-center" action="/login" method="POST">
                <input
                class="input w-full"
                type="text"
                name="username"
                value="<%= typeof username !== 'undefined' ? username : '' %>"
                required 
                >
                <input type="password" name="password" id="password" class="input" required>
                <button class="text-bat-yellow border-2 border-bat-yellow w-20 navBtn" type="submit">Submit</button>
            </form>
        </div>
    </div>
    
    <%- include('partials/footer') %>

    <script>
    const password = document.querySelector("#password");

    password.addEventListener("click", () => {
        password.type =
            password.type === "password" ? "text" : "password";
    });
</script>
</body>
</html>
